# Never commit a real API key. Revoke any key shared in a message or screenshot.
GEMINI_API_KEY=replace_with_a_new_rotated_key

# Current defaults from the Gemini API documentation. They can be changed here
# without editing application code when Google updates preview model names.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_VOICE=Kore
