{
  "name": "rohan-study-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cambridge AS study tools for Rohan",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "voice-lesson": "node src/generate-voice-lesson.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@google/genai": "2.17.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wav": "1.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
